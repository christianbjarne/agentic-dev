{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/1.4.0/schema.json",
  "name": "barRate",
  "position": {
    "x": 48,
    "y": 400,
    "z": 10000,
    "width": 456,
    "height": 288
  },
  "visual": {
    "visualType": "barChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_ratecode"
                    }
                  },
                  "Property": "ratecode_name"
                }
              },
              "queryRef": "dim_ratecode.ratecode_name",
              "nativeQueryRef": "ratecode_name"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_trips"
                    }
                  },
                  "Property": "Total Trips"
                }
              },
              "queryRef": "fact_trips.Total Trips",
              "nativeQueryRef": "Total Trips"
            }
          ]
        }
      }
    },
    "objects": {
      "dataPoint": [
        {
          "properties": {
            "defaultColor": {
              "solid": {
                "color": {
                  "expr": {
                    "Literal": {
                      "Value": "'#4A8DDC'"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Trips by Rate Type'"
                }
              }
            },
            "heading": {
              "expr": {
                "Literal": {
                  "Value": "'Heading3'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}