{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/1.4.0/schema.json",
  "name": "donut1",
  "position": {
    "x": 0,
    "y": 0,
    "z": 0,
    "width": 320,
    "height": 240
  },
  "visual": {
    "visualType": "donutChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_payment"
                    }
                  },
                  "Property": "payment_name"
                }
              },
              "queryRef": "dim_payment.payment_name",
              "nativeQueryRef": "payment_name"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_trips"
                    }
                  },
                  "Property": "Total Revenue"
                }
              },
              "queryRef": "fact_trips.Total Revenue",
              "nativeQueryRef": "Total Revenue"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Revenue by Payment Type'"
                }
              }
            },
            "heading": {
              "expr": {
                "Literal": {
                  "Value": "'Heading3'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}