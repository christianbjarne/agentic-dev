relationship rel_date
	fromColumn: fact_trips.pickup_date_key
	toColumn: dim_date.date_key

relationship rel_zone
	fromColumn: fact_trips.pickup_location_id
	toColumn: dim_zone.location_id

relationship rel_vendor
	fromColumn: fact_trips.vendor_id
	toColumn: dim_vendor.vendor_id

relationship rel_payment
	fromColumn: fact_trips.payment_type
	toColumn: dim_payment.payment_type

relationship rel_ratecode
	fromColumn: fact_trips.ratecode_id
	toColumn: dim_ratecode.ratecode_id

