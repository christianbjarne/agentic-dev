/// KMeans operational and revenue segment assigned to each pickup zone.
table ml_zone_clusters

	/// Number of pickup zones assigned to a KMeans segment.
	measure 'ML Zone Count' = DISTINCTCOUNT(ml_zone_clusters[pickup_location_id])
		formatString: #,0

	/// Revenue represented by the current KMeans segment selection.
	measure 'ML Segment Revenue' = SUM(ml_zone_clusters[total_revenue])
		formatString: $#,0

	/// Trips represented by the current KMeans segment selection.
	measure 'ML Segment Trips' = SUM(ml_zone_clusters[trip_count])
		formatString: #,0

	/// Average zone tip-to-fare ratio in the selected segment.
	measure 'ML Avg Tip %' = AVERAGE(ml_zone_clusters[avg_tip_pct])
		formatString: 0.0%

	/// TLC pickup-zone key.
	column pickup_location_id
		dataType: int64
		summarizeBy: none
		sourceColumn: pickup_location_id

	/// New York City borough.
	column borough
		dataType: string
		summarizeBy: none
		sourceColumn: borough

	/// Taxi-zone name.
	column zone
		dataType: string
		summarizeBy: none
		sourceColumn: zone_name

	/// Human-readable KMeans segment.
	column cluster_label
		dataType: string
		summarizeBy: none
		sourceColumn: cluster_label

	/// Average fare for the zone.
	column avg_fare
		dataType: double
		summarizeBy: none
		sourceColumn: average_fare

	/// Average tip divided by average fare.
	column avg_tip_pct
		dataType: double
		summarizeBy: none
		sourceColumn: avg_tip_pct

	/// Trips represented in the zone segment.
	column trip_count
		dataType: int64
		summarizeBy: none
		sourceColumn: trip_count

	/// Total revenue represented in the zone segment.
	column total_revenue
		dataType: double
		summarizeBy: none
		sourceColumn: total_revenue

	partition ml_zone_clusters = entity
		mode: directLake
		source
			entityName: tbl_nyc_taxi_ml_zone_clusters
			expressionSource: DirectLake

