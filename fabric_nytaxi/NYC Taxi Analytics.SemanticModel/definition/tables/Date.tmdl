/// Calendar dimension covering every date in 2025 for trip analysis.
table Date
	lineageTag: 3be69a0a-f606-4bb5-a95b-a91ade7f1a36
	dataCategory: Time

	column 'Date Key'
		dataType: int64
		isHidden
		isKey
		lineageTag: 6b607560-df32-45e7-bde1-cfdc63c24716
		summarizeBy: none
		sourceColumn: date_key

	/// Calendar date used to filter trips.
	column Date
		dataType: dateTime
		isUnique
		lineageTag: eebbb171-998c-4e00-8419-1d622a62a25c
		sourceColumn: date

	column Year
		dataType: int64
		lineageTag: 744d6a8f-c790-49f7-b9cf-e8ee7aeeb16a
		summarizeBy: none
		sourceColumn: year

	column 'Quarter Number'
		dataType: int64
		isHidden
		lineageTag: 70b7901e-54a3-4752-b9b3-012cc9f588cc
		summarizeBy: none
		sourceColumn: quarter_number

	column Quarter
		dataType: string
		lineageTag: d47f1d47-d985-4241-a411-efdae57aafde
		summarizeBy: none
		sourceColumn: quarter_name

	column 'Month Number'
		dataType: int64
		isHidden
		lineageTag: 5b336ee7-b3ea-47f3-a057-0ef3418bb798
		summarizeBy: none
		sourceColumn: month_number

	column Month
		dataType: string
		lineageTag: cbbfa28e-af91-423b-99af-2cdb77c84388
		summarizeBy: none
		sourceColumn: month_name
		sortByColumn: 'Month Number'

	/// First calendar day of the month.
	column 'Month Start'
		dataType: dateTime
		lineageTag: d8904d02-1310-45de-88ca-95b71ecdb067
		sourceColumn: month_start

	column 'Year Month'
		dataType: string
		lineageTag: d8851cd0-0a2a-4244-a6cf-8e5215b64603
		summarizeBy: none
		sourceColumn: year_month

	column 'Day of Month'
		dataType: int64
		lineageTag: 9ae77a4d-5fd4-4e87-8602-1a0f971d0975
		summarizeBy: none
		sourceColumn: day_of_month

	column 'Day of Week Number'
		dataType: int64
		isHidden
		lineageTag: a9cb38a7-59d9-4136-bdc1-8158c3a02fb9
		summarizeBy: none
		sourceColumn: day_of_week_number

	column 'Day Name'
		dataType: string
		lineageTag: 681396a2-0fd1-4b5a-9fde-7badcc7c781b
		summarizeBy: none
		sourceColumn: day_name
		sortByColumn: 'Day of Week Number'

	column 'Week of Year'
		dataType: int64
		lineageTag: 31b32b78-16ed-431d-9f96-9d70b077841c
		summarizeBy: none
		sourceColumn: week_of_year

	column 'Is Weekend'
		dataType: boolean
		lineageTag: 3f892ee4-da75-49ae-9297-927c4525a647
		summarizeBy: none
		sourceColumn: is_weekend

	partition Date = entity
		mode: directLake
		source
			entityName: dim_date
			schemaName: silver
			expressionSource: 'DirectLake - NYC Taxi Analytics'

