/// Cleaned 2025 standard for-hire vehicle trips at one row per trip.
table 'For-Hire Vehicle Trips'
	lineageTag: 310c5843-582c-44d1-93df-1a71abd1dfa0

	/// Count of cleaned standard FHV fact rows.
	measure 'FHV Trip Count' = COUNTROWS('For-Hire Vehicle Trips')
		formatString: #,##0
		displayFolder: Trip Detail
		lineageTag: 18abdcaf-d767-4b2c-8cd9-160132d73567

	column 'Pickup Date Key'
		dataType: int64
		isHidden
		lineageTag: ca79d29c-af44-45b2-b6d5-c3d28ad1a506
		summarizeBy: none
		sourceColumn: pickup_date_key

	column 'Pickup Location ID'
		dataType: int64
		isHidden
		lineageTag: c9193aa3-ce7a-4abc-83f5-0e17dfedd189
		summarizeBy: none
		sourceColumn: pickup_location_id

	column 'Dropoff Location ID'
		dataType: int64
		isHidden
		lineageTag: 700cee77-cf90-4f91-8963-96a579742ff6
		summarizeBy: none
		sourceColumn: dropoff_location_id

	column 'Service Type Key'
		dataType: int64
		isHidden
		lineageTag: 22dd54ea-d675-48eb-a63d-895bdb0704ce
		summarizeBy: none
		sourceColumn: service_type_key

	/// Hour of day when the trip began.
	column 'Pickup Hour'
		dataType: int64
		lineageTag: 176a2fbd-4289-4181-80d0-e509a87336f3
		summarizeBy: none
		sourceColumn: pickup_hour

	column 'Trip Duration Minutes'
		dataType: decimal
		isHidden
		lineageTag: 329c6cf4-3a50-447a-9f85-27e4f0f671ed
		sourceColumn: trip_duration_minutes

	column 'Shared Request Flag'
		dataType: string
		lineageTag: f27f561c-141f-4693-8af9-4cab15d80414
		summarizeBy: none
		sourceColumn: shared_request_flag

	partition 'For-Hire Vehicle Trips' = entity
		mode: directLake
		source
			entityName: fact_fhv_trip
			schemaName: silver
			expressionSource: 'DirectLake - NYC Taxi Analytics'

