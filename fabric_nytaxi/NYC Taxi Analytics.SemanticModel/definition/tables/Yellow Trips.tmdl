/// Cleaned 2025 yellow taxi trips at one row per trip.
table 'Yellow Trips'
	lineageTag: 711c10ea-ad74-489c-8033-9b0de990fc82

	/// Count of cleaned yellow taxi fact rows.
	measure 'Yellow Trip Count' = COUNTROWS('Yellow Trips')
		formatString: #,##0
		displayFolder: Trip Detail
		lineageTag: 70856b1b-ff8e-4282-b757-f2e54a76523f

	column 'Pickup Date Key'
		dataType: int64
		isHidden
		lineageTag: 3ee68974-4f53-4dee-8575-f98f5eec7371
		summarizeBy: none
		sourceColumn: pickup_date_key

	column 'Pickup Location ID'
		dataType: int64
		isHidden
		lineageTag: 6be76b29-a6ca-4317-bf32-51428369a7d9
		summarizeBy: none
		sourceColumn: pickup_location_id

	column 'Dropoff Location ID'
		dataType: int64
		isHidden
		lineageTag: d72f7539-0b07-493b-8c2a-587ffa631c1c
		summarizeBy: none
		sourceColumn: dropoff_location_id

	column 'Service Type Key'
		dataType: int64
		isHidden
		lineageTag: 7dbf3290-ff07-4f64-8934-a129c8ea062a
		summarizeBy: none
		sourceColumn: service_type_key

	column 'Vendor ID'
		dataType: int64
		isHidden
		lineageTag: 1797e9db-2cad-42ea-a4c1-9322213a1716
		summarizeBy: none
		sourceColumn: vendor_id

	column 'Rate Code ID'
		dataType: int64
		isHidden
		lineageTag: 3828e947-f57d-4c08-8583-942ab95fdfe6
		summarizeBy: none
		sourceColumn: rate_code_id

	column 'Payment Type ID'
		dataType: int64
		isHidden
		lineageTag: 44102bb5-b1f0-435d-9fe7-d2a4a62f386e
		summarizeBy: none
		sourceColumn: payment_type_id

	/// Hour of day when the trip began.
	column 'Pickup Hour'
		dataType: int64
		lineageTag: f29050f7-66e7-4b20-a39a-2d579c56827d
		summarizeBy: none
		sourceColumn: pickup_hour

	column 'Passenger Count'
		dataType: int64
		isHidden
		lineageTag: 2cfd4b50-4662-4489-a48c-e75d6f600f3c
		sourceColumn: passenger_count

	column 'Trip Distance'
		dataType: decimal
		isHidden
		lineageTag: 07c3d3cc-8b48-40f3-8fa2-cc245b9629aa
		sourceColumn: trip_distance

	column 'Trip Duration Minutes'
		dataType: decimal
		isHidden
		lineageTag: 382dd7b8-1d4d-4723-9056-7d6684bfa57e
		sourceColumn: trip_duration_minutes

	column 'Fare Amount'
		dataType: decimal
		isHidden
		lineageTag: 3b4cf2f9-9f72-4271-a781-220d28976ad0
		sourceColumn: fare_amount

	column 'Tip Amount'
		dataType: decimal
		isHidden
		lineageTag: 9707b73d-1c3d-48de-a446-6b330c69ce0b
		sourceColumn: tip_amount

	column 'Tolls Amount'
		dataType: decimal
		isHidden
		lineageTag: 104c4ce0-baf5-4edc-acea-8a4412f9d3fd
		sourceColumn: tolls_amount

	column 'Total Amount'
		dataType: decimal
		isHidden
		lineageTag: 8868d633-ded7-4a19-ad69-588822083ac6
		sourceColumn: total_amount

	column 'Congestion Surcharge Amount'
		dataType: decimal
		isHidden
		lineageTag: 0f19c560-5ff0-4931-abfb-dc402f4afd25
		sourceColumn: congestion_surcharge_amount

	column 'Airport Fee Amount'
		dataType: decimal
		isHidden
		lineageTag: 039c4c93-8da1-4814-a870-ded14237b5eb
		sourceColumn: airport_fee_amount

	column 'CBD Congestion Fee Amount'
		dataType: decimal
		isHidden
		lineageTag: a006bf45-53c4-4e6c-9b0e-d0871b199f32
		sourceColumn: cbd_congestion_fee_amount

	partition 'Yellow Trips' = entity
		mode: directLake
		source
			entityName: fact_yellow_trip
			schemaName: silver
			expressionSource: 'DirectLake - NYC Taxi Analytics'

