/// Taxi zone where a trip ended.
table 'Dropoff Zone'
	lineageTag: 42c59f7b-9568-4df2-b493-51115a450ce7

	column 'Location ID'
		dataType: int64
		isHidden
		isKey
		lineageTag: 0b726d32-78f6-4c3c-ba5e-a2a92223e6de
		summarizeBy: none
		sourceColumn: location_id

	/// NYC borough or special area containing the dropoff zone.
	column Borough
		dataType: string
		lineageTag: 5400e236-88fe-45b0-aee9-8e638ee6e9d1
		summarizeBy: none
		sourceColumn: borough

	/// Official TLC taxi-zone name.
	column Zone
		dataType: string
		lineageTag: 5fa5665c-c96b-4d73-a44c-eeded7bc5e1f
		summarizeBy: none
		sourceColumn: zone_name

	column 'Service Zone'
		dataType: string
		lineageTag: 745857d0-6b8a-4849-9e64-d0b883631690
		summarizeBy: none
		sourceColumn: service_zone

	partition 'Dropoff Zone' = entity
		mode: directLake
		source
			entityName: dim_taxi_zone
			schemaName: silver
			expressionSource: 'DirectLake - NYC Taxi Analytics'

