/// TLC fare rate-code dimension.
table dim_ratecode

	/// Rate-code key.
	column ratecode_id
		dataType: int64
		summarizeBy: none
		sourceColumn: ratecode_id

	/// Rate-code description.
	column ratecode_name
		dataType: string
		summarizeBy: none
		sourceColumn: ratecode_name

	partition dim_ratecode = entity
		mode: directLake
		source
			entityName: tbl_nyc_taxi_dim_ratecode
			expressionSource: DirectLake

